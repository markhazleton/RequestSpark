{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devspark.local/schemas/okf-knowledge-document.schema.json",
  "title": "DevSpark OKF Knowledge Document",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "okf_schema_version",
    "document_id",
    "document_type",
    "feature_id",
    "title",
    "status",
    "updated_at"
  ],
  "properties": {
    "okf_schema_version": {
      "type": "string",
      "pattern": "^1\\.0$"
    },
    "document_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "requirement",
        "task",
        "gate-evidence",
        "traceability-index",
        "decision"
      ]
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[0-9]{3}-[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "superseded",
        "complete"
      ]
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^FR-[0-9]{3}$"
      },
      "uniqueItems": true,
      "default": []
    },
    "task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^T[0-9]{3}$"
      },
      "uniqueItems": true,
      "default": []
    },
    "gate_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._:-]*$"
      },
      "uniqueItems": true,
      "default": []
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
